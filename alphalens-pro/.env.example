# In .env kopieren und ausfüllen (Datei .env wird NICHT committet).
# Nur ANTHROPIC_API_KEY ist für KI-Features nötig; die Datenpipeline läuft auch ohne Keys (yfinance).

# https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# Optional: https://finnhub.io/ (Free Tier) — News & Earnings-Kalender
FINNHUB_API_KEY=

# Optional: https://www.alphavantage.co/support/#api-key (Free) — Fallback-Kursdaten
ALPHAVANTAGE_API_KEY=
